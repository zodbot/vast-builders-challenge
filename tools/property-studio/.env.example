# Source the actual team config first. This file contains no credentials.
HOST=127.0.0.1
PORT=8080
PROPERTY_DATA_DIR=.property-data
# Required when the app is accessible beyond localhost:
PROPERTY_APP_TOKEN=
# Preserve COSMOS3_REASON_URL and GPU_BEARER_TOKEN from the workshop environment.
COSMOS3_REASON_MODEL=
PROPERTY_LLM_BASE_URL=https://api.inference.wandb.ai/v1
PROPERTY_LLM_MODEL=
# WANDB_API_KEY, WANDB_TEAM and WANDB_PROJECT come from the workshop environment.
BRAVE_SEARCH_API_KEY=
# Approved application bucket only. Never use watched chunks / segments buckets.
PROPERTY_S3_BUCKET=
PROPERTY_S3_PREFIX=property-studio
# Optional artifact-tool workbook runtime. Without it, a portable formula exporter is used.
PROPERTY_NODE_BIN=node
PROPERTY_ARTIFACT_MODULE=@oai/artifact-tool
# On the workshop ingress only:
# PROPERTY_ROOT_PATH=/app
